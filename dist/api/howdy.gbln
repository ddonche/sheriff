/// Local HTTP scripts run from dist. Resolve module imports in Core instead.
act handle()
    if :env("GOBLIN_METHOD") != "POST" => return {"ok":false,"stderr":"Use POST for Howdy settings."}
    if :env("SHERIFF_RUNTIME_MODE") == "cloud" => return {"ok":false,"stderr":"Use the authenticated Cloud Desk gateway."}
    root | :env("SHERIFF_ROOT")
    if root.nix? => root |= ".."
    body | :env("GOBLIN_BODY") ?? ""
    incoming | :env("GOBLIN_REQUEST_FILE")
    if !incoming.nix? => body |= :read_text(incoming)
    if body.len > 4194304 => return {"ok":false,"stderr":"Configuration is too large."}
    folder | "{root}/data/desk-howdy-requests"
    :create_dir!(folder)
    id | :uuid_v4()
    file | "{folder}/{id}.json"
    :write_text!(file, body)
    result | nil
    attempt
        result |= :json_parse(:run_cmd("goblin run desk/admin/requests/howdy_request.gbln", "{root}/sheriff-core", {"SHERIFF_ROOT":root,"GOBLIN_METHOD":"POST","GOBLIN_BODY":"","GOBLIN_REQUEST_FILE":"../data/desk-howdy-requests/{id}.json"}))
    ensure
        :delete_path!(file)
    xx
    if result{"ok"} == false => return {"ok":false,"stderr":result{"stderr"}}
    data | :json_parse(result{"stdout"})
    while :valtype(data) == "map" and :has(data, "body") and :has(data, "status")
        data |= data{"body"}
        if :valtype(data) == "str" => data |= :json_parse(data)
    xx
    return data
xx
attempt
    :say(:json_stringify(handle()))
rescue err
    :say(:json_stringify({"ok":false,"stderr":"Howdy settings could not be read. " + :str(err)}))
xx
