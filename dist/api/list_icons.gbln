/// /api/list_icons?{portal}: Core icons plus portal-local overrides. Read-only.
act explicit_brand(root, name)
    if :starts_with(name, "brand-") == false => return false
    slug | :keep_after(name, "brand-") ?? ""
    return :file_exists("{root}/sheriff-core/assets/simple-icons/icons/{slug}.svg")
xx

root | :trim(:env("SHERIFF_ROOT"))
if root == "" => root |= ".."
portal | :trim(:url_decode(:env("GOBLIN_QUERY_STRING")))
known | :list_dirs("{root}/site/portals")
valid_portal | false
for name in known
    if name == portal => valid_portal |= true
xx
if !portal.nix? and valid_portal == false
    :say(:json_stringify({"ok": false, "stderr": "Unknown portal", "icons": []}))
else
    by_name | {}
    names | []
    occupied | {}
    for folder in ["{root}/sheriff-core/assets/icons", "{root}/site/portals/{portal}/public/icons"]
        if :file_exists(folder) == false => skip
        for file in :walk(folder, "**/*")
            if :ends_with(file, ".svg") or :ends_with(file, ".png")
                :update!(occupied{:stem(file)}, true)
            xx
        xx
    xx
    /// The explicit brand- prefix always selects Simple Icons. Bare names are
    /// offered where they do not replace an existing Core or portal icon.
    brand_metadata | "{root}/sheriff-core/assets/simple-icons/metadata.json"
    if :file_exists(brand_metadata) == true
        for brand in :read_json(brand_metadata)
            slug | brand{"name"}
            file | "{root}/sheriff-core/assets/simple-icons/icons/{slug}.svg"
            if :file_exists(file) == false => skip
            name | (slug)
            if :has(occupied, name) == true
                name |= "brand-{slug}"
            xx
            :put_last!(names, name)
            :update!(by_name{name}, {"name":name,"title":brand{"title"},"source":"Simple Icons","collection":"brands","brandColor":brand{"brandColor"},"svg": :read_text(file)})
        xx
    xx
    folders | [{"path": "{root}/sheriff-core/assets/icons", "source": "Core"}]
    if valid_portal
        :put_last!(folders, {"path": "{root}/site/portals/{portal}/public/icons", "source": "Portal"})
    xx
    for folder in folders
        dir | folder{"path"}
        if :file_exists(dir) == false => skip
        has_png | false
        for file in :walk(dir, "**/*")
            if :ends_with(file, ".png") => has_png |= true
        xx
        if folder{"source"} == "Portal" and has_png
            command | "python3 sheriff-core/desk/api/icon-support/png-icons.py"
            if :env("OS") == "Windows_NT"
                command |= "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File sheriff-core/desk/api/icon-support/png-icons.ps1"
            xx
            result | :json_parse(:run_cmd(command, root, {"SHERIFF_ICON_DIRECTORY": "site/portals/{portal}/public/icons"}))
            if result{"ok"} == false
                :say(:json_stringify({"ok": false, "stderr": "Could not load PNG icons. Windows uses PowerShell; macOS/Linux require Python 3.", "icons": []}))
                return nil
            xx
            for icon in :json_parse(result{"stdout"})
                name | icon{"name"}
                if explicit_brand(root, name) => skip
                if :has(by_name, name) == false => :put_last!(names, name)
                :update!(by_name{name}, icon)
            xx
        xx
        for file in :walk(dir, "**/*")
            if :ends_with(file, ".svg") == false => skip
            name | :stem(file)
            if :slug(name) != name => skip
            if explicit_brand(root, name) => skip
            if :has(by_name, name) == false => :put_last!(names, name)
            :update!(by_name{name}, {"name": name, "source": folder{"source"}, "collection": :lower(folder{"source"}), "svg": :read_text(file)})
        xx
    xx
    icons | []
    for name in :sort(names)
        :put_last!(icons, by_name{name})
    xx
    :say(:json_stringify({"ok": true, "icons": icons}))
xx
