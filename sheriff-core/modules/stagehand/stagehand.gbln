/// modules/stagehand/stagehand.gbln
/// Stagehand: backstage crew for Sheriff.
/// - Copies theme/public assets (once per portal)
/// - Wires layout slots from templates.yall into SLOT::* tokens
/// - Expands SLOT::* into the layout HTML, leaving module tokens for others

/// Copy ONLY the active theme's CSS + the portal's public/ assets.
/// Active theme is read from ../site/portals/{portal}/config.yall:
///
/// theme:
///   name: outpost
///
/// If missing, defaults to "outpost".

act resolve_theme_name(portal)
    config_path|"../site/portals/{portal}/config.yall"
    theme_name|"outpost"

    if :file_exists(config_path)
        cfg|:yall_parse_file(config_path)
        if !cfg.nix? && :valtype(cfg)=="map" && !cfg{"theme"}.nix?
            theme_cfg|cfg{"theme"}
            if :valtype(theme_cfg)=="map" && !theme_cfg{"name"}.nix?
                :update!(theme_name,:trim(theme_cfg{"name"}))
            xx
        xx
    xx

    return theme_name
xx

act copy_assets(pre_ctx)
    portal | pre_ctx{"portal"}
    if portal.nix?
        :say("STAGEHAND: No portal in pre_ctx; skipping copy_assets")
        return pre_ctx
    xx
    /// ----- 1) Determine active theme name from config.yall -----
    config_path | "../site/portals/{portal}/config.yall"
    theme_name  | "outpost"   /// sensible default
    if :file_exists(config_path)
        cfg | :yall_parse_file(config_path)
        if !cfg.nix? && !cfg{"theme"}.nix?
            theme_cfg | cfg{"theme"}
            if !theme_cfg{"name"}.nix?
                :update!(theme_name, :trim(theme_cfg{"name"}))
            xx
        xx
    xx
    :say("STAGEHAND: Active theme for portal '{portal}' is '{theme_name}'")
    /// ----- 2) Copy theme CSS (single file) from sheriff-core into dist/{portal}/public/css -----
    theme_css_src   | "../sheriff-core/themes/{theme_name}/css/{theme_name}.css"
    theme_header_css_src   | "../sheriff-core/themes/{theme_name}/css/{theme_name}-header.css"
    public_css_dest | "../dist/{portal}/public/css"
    if :file_exists(theme_css_src)
        :create_dir!(public_css_dest)
        dest  | "{public_css_dest}/{theme_name}.css"
        dest2 | "{public_css_dest}/{theme_name}-header.css"
        :copy_file!(theme_css_src, dest)
        :copy_file!(theme_header_css_src, dest2)
        :say("STAGEHAND: Copied theme CSS '{theme_name}.css' from sheriff-core")
    else
        :say("STAGEHAND: Theme CSS NOT FOUND for theme '{theme_name}' at {theme_css_src}")
    xx
    /// Core icon defaults are copied before portal public assets, so portals can override them.
    core_icons | "../sheriff-core/assets/icons"
    if :file_exists(core_icons)
        :create_dir!("../dist/{portal}/public/icons")
        for icon_path in :walk(core_icons, "*.svg")
            icon_file | :basename(icon_path)
            :copy_file!(icon_path, "../dist/{portal}/public/icons/{icon_file}")
        xx
    xx
    /// ----- 3) Copy portal public/ → dist/{portal}/public -----
    public_src  | "../site/portals/{portal}/public"
    public_dest | "../dist/{portal}/public"
    assets_copied | 0
    if :file_exists(public_src)
        :create_dir!(public_dest)
        for asset in :walk(public_src, "**/*.*")
            rel_path | :path_relative_to(asset, public_src)
            dir      | :dirname(rel_path)
            dest     | "{public_dest}/{rel_path}"
            if dir != ""
                dest_dir | "{public_dest}/{dir}"
                if :file_exists(dest_dir) == false
                    :create_dir!(dest_dir)
                xx
            xx
            :copy_file!(asset, dest)
            :update!(assets_copied, assets_copied + 1)
        xx
        :say("STAGEHAND: Copied {assets_copied} public assets")
    else
        :say("STAGEHAND: No public/ folder for portal '{portal}', skipping")
    xx
    /// ------------------------------------------------------------
    /// Theme override.css (portal-scoped, theme-scoped)
    /// If present in portal theme folder, copy it to dist as override.css
    /// Else ensure a starter override.css exists so layouts can always link it
    /// ------------------------------------------------------------
    override_src  | "../site/portals/{portal}/themes/{theme_name}/override.css"
    override_dest | "../dist/{portal}/public/css/override.css"
    :create_dir!("../dist/{portal}/public/css")
    if :file_exists(override_src)
        :copy_file!(override_src, override_dest)
        :say("STAGEHAND: Copied override.css from portal theme folder")
    else
        if :file_exists(override_dest) == false
            override_starter | "../sheriff-core/themes/override-starter.css"
            if :file_exists(override_starter)
                :copy_file!(override_starter, override_dest)
                :say("STAGEHAND: Wrote starter override.css")
            else
                :write_text!(override_dest, "/* portal/theme overrides */\n")
                :say("STAGEHAND: Wrote empty override.css")
            xx
        else
            :say("STAGEHAND: override.css already exists; leaving as-is")
        xx
    xx
    /// Core-owned browser behavior is available to every portal, including old ones.
    tabs_js_src | "../sheriff-core/modules/markdown_core/sheriff-content-tabs.js"
    if :file_exists(tabs_js_src)
        :create_dir!("../dist/{portal}/public/js")
        :copy_file!(tabs_js_src, "../dist/{portal}/public/js/sheriff-content-tabs.js")
    xx
    /// ----- 4) Copy index.html from content/ to dist/{portal} if it exists -----
    index_src  | "../site/portals/{portal}/content/index.html"
    index_dest | "../dist/{portal}/index.html"
    if :file_exists(index_src)
        :copy_file!(index_src, index_dest)
        :say("STAGEHAND: Copied custom index.html to dist/{portal}/index.html")
    xx
    /// Hosted Sheriff keeps its own application and API files in dist.
    if :lower(:trim(:env("SHERIFF_RUNTIME_MODE"))) == "cloud"
        :say("STAGEHAND: Cloud mode; skipping local Sheriff Desk sync")
        return pre_ctx
    xx

    /// ------------------------------------------------------------
    /// 5) Sync Sheriff Desk (local admin) from sheriff-core → dist root
    /// desk/index.html → dist/index.html, desk/admin/ → dist/admin/
    /// dist/admin is cleared first so removed/renamed desk files do
    /// not linger in dist as live .gbln endpoints
    /// ------------------------------------------------------------
    desk_src  | "../sheriff-core/desk"
    dist_root | "../dist"
    if :file_exists(desk_src)
        if :file_exists("{dist_root}/admin")
            :delete_path!("{dist_root}/admin")
        xx
        if :file_exists("{dist_root}/api")
            :delete_path!("{dist_root}/api")
        xx
        desk_copied | 0
        for asset in :walk(desk_src, "**/*.*")
            rel_path | :path_relative_to(asset, desk_src)
            dir      | :dirname(rel_path)
            dest     | "{dist_root}/{rel_path}"
            if dir != ""
                dest_dir | "{dist_root}/{dir}"
                if :file_exists(dest_dir) == false
                    :create_dir!(dest_dir)
                xx
            xx
            :copy_file!(asset, dest)
            :update!(desk_copied, desk_copied + 1)
        xx
        :say("STAGEHAND: Synced Sheriff Desk ({desk_copied} files) to dist")
    else
        :say("STAGEHAND: sheriff-core/desk not found; skipping Desk sync")
    xx
    return pre_ctx
xx

/// ----------------------------------------------------------------------
/// Helper: given ["BRINDLE::LOGO", "BADGE::VERSION"]
/// return a single string:
///   "{{{BRINDLE::LOGO}}}{{{BADGE::VERSION}}}"
/// Raw braces so Goblin doesn't eat them at parse-time.
/// ----------------------------------------------------------------------
act build_slot_value(slot_tokens)
    if slot_tokens.nix? => return ""

    value | ""

    for tok in slot_tokens
        open  | raw "{{{"
        close | raw "}}}"
        token | :trim(tok)
        if token.nix? => skip
        if :starts_with(token, open) and :ends_with(token, close)
            :update!(value, value ++ token)
        else
            :update!(value, value ++ open + token + close)
        xx
    xx

    return value
xx

/// Read one layout's slots. Missing portal entries inherit the Core theme.
act load_layout_slots(templates_path, layout_name)
    if :file_exists(templates_path) == false => return {}
    templates | :yall_parse_file(templates_path)
    if :valtype(templates) != "map" => return {}
    layouts_cfg | templates{"layouts"} ?? {}
    if :valtype(layouts_cfg) != "map" => return {}
    layout_cfg | layouts_cfg{layout_name} ?? {}
    if :valtype(layout_cfg) != "map" => return {}
    slots | layout_cfg{"slots"} ?? {}
    if :valtype(slots) != "map" => return {}
    return slots
xx

/// Inherit Core slots, then apply portal overrides per slot. An explicitly
/// empty portal slot stays empty. Restore the registry after expanding this
/// page so custom slots cannot leak into another layout or portal.
act wire_slots(ctx)
    portal | ctx{"portal"} ?? => return ctx
    fm     | ctx{"frontmatter"}
    body   | ctx{"body"} ?? => return ctx

    layout_name | "docs"
    if :valtype(fm) == "map" && :has(fm, "layout") && !fm{"layout"}.nix?
        layout_name |= :trim(fm{"layout"})
    xx

    theme_name | resolve_theme_name(portal)
    core_slots | load_layout_slots("../sheriff-core/themes/{theme_name}/templates.yall", layout_name)
    portal_slots | load_layout_slots("../site/portals/{portal}/themes/{theme_name}/templates.yall", layout_name)
    slots_cfg | {}
    for pair in core_slots
        :update!(slots_cfg{pair[0]}, pair[1])
    xx
    for pair in portal_slots
        :update!(slots_cfg{pair[0]}, pair[1])
    xx

    previous | []
    for pair in slots_cfg
        slot_name | pair[0]
        token | "\{\{\{SLOT::{slot_name}\}\}\}"
        :put_last!(previous, {"name": slot_name, "token": token, "value": resolve_token(token)})
        register_token("SLOT", slot_name, build_slot_value(pair[1]))
    xx

    rendered | resolve_token(body)
    for entry in previous
        if entry{"value"} == entry{"token"}
            clear_token("SLOT", entry{"name"})
        else
            register_token("SLOT", entry{"name"}, entry{"value"})
        xx
    xx
    :update!(ctx{"body"}, rendered)
    return ctx
xx
