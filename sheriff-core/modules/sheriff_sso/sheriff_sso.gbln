/// modules/sheriff_sso/sheriff_sso.gbln
/// Sheriff SSO — shared auth module.
///
/// One identity (Supabase Auth) used everywhere. This module is the portable
/// half of Sheriff SSO: it verifies tokens on a backend, and reads/writes the
/// on-disk credential the CLI and any local backend share
/// (~/.sheriff/credentials.json).
///
/// Consumers:
///   - Sheriff Cloud / Sheriff Desk backend  → verify(token)
///   - Glamr CLI                             → load_creds / save_creds / token
///
/// Env expected:
///   SUPABASE_URL       e.g. https://xxxx.supabase.co  (no trailing slash)
///   SUPABASE_ANON_KEY  the project's anon/public key
///
/// verify() mirrors auth-proxy/index.ts: hand the JWT to Supabase's
/// /auth/v1/user endpoint and trust its answer. No local JWT-secret handling.
///
/// NOTE: :http_get is only available under the VM engine, so any backend that
/// calls verify() must run goblin with `--vm` (e.g. `goblin --vm start ...`).

/// ── small helpers ─────────────────────────────────────────────────────────

/// Safe map read: goblin raises on a missing key, so guard with :has first.
act mget(m, k, d)
    if :valtype(m) == "map" and :has(m, k)
        return m{k}
    xx
    return d
xx

/// :http_get may return the body string directly or a response map, depending
/// on the build. Normalize to the body text either way.
act http_body(resp)
    if :valtype(resp) == "map"
        return "" + mget(resp, "body", mget(resp, "text", ""))
    xx
    return "" + resp
xx

/// ── config helpers ────────────────────────────────────────────────────────

act supabase_url()
    value | :trim(:env("SUPABASE_URL"))
    if !value.nix? => return value
    cfg | :read_json("modules/sheriff_sso/service.json")
    return cfg{"url"}
xx

act anon_key()
    value | :trim(:env("SUPABASE_ANON_KEY"))
    if !value.nix? => return value
    cfg | :read_json("modules/sheriff_sso/service.json")
    return cfg{"public_key"}
xx

act home_dir()
    home | :trim(:env("HOME"))
    if home == ""
        home |= :trim(:env("USERPROFILE"))   /// windows fallback
    xx
    return home
xx

/// Path to the shared credential file: ~/.sheriff/credentials.json
act cred_path()
    home | home_dir()
    return "{home}/.sheriff/credentials.json"
xx

/// ── verification (backend side) ───────────────────────────────────────────

/// verify(token) → map
///   { "ok": true,  "user_id": "...", "email": "..." }   on success
///   { "ok": false, "error": "..." }                     otherwise
///
/// A valid Supabase JWT resolves to a user object containing "id"; anything
/// else — bad token, expired token, network error — is unauthorized.
act verify(token)
    tok | :trim(token)
    if tok == ""
        return { "ok": false, "error": "missing token" }
    xx

    base | supabase_url()
    if base == ""
        return { "ok": false, "error": "SUPABASE_URL not set" }
    xx

    headers | {
        "Authorization": "Bearer {tok}",
        "apikey": anon_key()
    }

    /// Network + parse are wrapped: a non-2xx that raises, a timeout, or a
    /// non-JSON body all fall through to "unauthorized" instead of crashing.
    user | {}
    attempt
        resp | :http_get("{base}/auth/v1/user", headers)
        body | http_body(resp)
        parsed | :json_parse(body)
        if :valtype(parsed) == "map"
            :update!(user, parsed)
        xx
    rescue
        return { "ok": false, "error": "invalid or expired token" }
    xx

    if :has(user, "id") == false
        return { "ok": false, "error": "invalid or expired token" }
    xx

    return {
        "ok": true,
        "user_id": user{"id"},
        "email": mget(user, "email", "")
    }
xx

/// ── credential file (client side) ─────────────────────────────────────────

/// load_creds() → map with access_token/refresh_token/expires_at, or {} if none
act load_creds()
    path | cred_path()
    if :file_exists(path) == false
        return {}
    xx
    parsed | {}
    attempt
        data | :json_parse(:read_text(path))
        if :valtype(data) == "map"
            :update!(parsed, data)
        xx
    rescue
        return {}
    xx
    return parsed
xx

/// save_creds(creds) — write the credential file (creates ~/.sheriff if needed).
/// NOTE: goblin core has no chmod builtin, so the CLI wrapper should chmod the
/// file to 600 (and the dir to 700) right after this returns.
act save_creds(creds)
    home | home_dir()
    dir | "{home}/.sheriff"
    if :file_exists(dir) == false
        :create_dir!(dir)
    xx
    :write_text!(cred_path(), :json_stringify(creds))
    return true
xx

/// token() → the stored access token, or "".
/// Refresh-on-expiry lives in the CLI wrapper (it needs the refresh_token flow
/// against /auth/v1/token); this returns the stored access token as-is.
act token()
    return mget(load_creds(), "access_token", "")
xx

/// whoami() → verify(token()); convenience for the CLI to print the user.
act whoami()
    return verify(token())
xx

/// logout() — remove the credential file.
act logout()
    path | cred_path()
    if :file_exists(path)
        :delete_path!(path)
    xx
    return true
xx

/// Resolve a public Sheriff username to its permanent account ID. This is the
/// existing identity directory; it does not manage permissions or portal source.
act find_account(username)
    name | :trim(username)
    if name.nix? or name.len > 80 => return {"ok":false,"error":"Enter an existing Sheriff username."}
    key | anon_key()
    response | :http_get(supabase_url() + "/rest/v1/profiles?select=id,username&username=eq." + :url_encode(name) + "&limit=1", {"apikey":key,"Authorization":"Bearer " + key})
    if :valtype(response) == "map" and (response{"status"} < 200 or response{"status"} >= 300) => return {"ok":false,"error":"Sheriff’s account directory could not be reached. Retry in a moment."}
    rows | :json_parse(http_body(response))
    if :valtype(rows) != "array" or rows.len != 1 => return {"ok":false,"error":"That Sheriff username was not found."}
    return {"ok":true,"id":rows[0]{"id"},"username":rows[0]{"username"}}
xx
