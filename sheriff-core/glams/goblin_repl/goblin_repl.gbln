act output_directory(portal, selected)
    if selected.nix? => return "../dist/{portal}"
    return selected
xx

/// Goblin WASM REPL embeds. The page schedule owns rendering; full and page
/// builds both publish the assets needed by an actual embed.
act copy_assets(portal, overwrite, output | "")
    glam_dir | "{#need::glams_dir}/goblin_repl"
    output_dir | "{#need::output_dir}"
    if !portal.nix? => output_dir |= (output_directory(portal, output) + "/public")
    manifest_source | "{glam_dir}/wasm/runtime.json"
    manifest_target | "{output_dir}/wasm/runtime.json"
    refresh | overwrite
    if !refresh
        if :file_exists(manifest_target) == false
            refresh |= true
        elif :read_text(manifest_target) != :read_text(manifest_source)
            refresh |= true
        xx
    xx
    for asset in [["js", "goblin-repl.js"], ["wasm", "goblin_wasm.js"], ["wasm", "goblin_wasm_bg.wasm"], ["wasm", "runtime.json"]]
        directory | asset[0]
        filename | asset[1]
        source | "{glam_dir}/{directory}/{filename}"
        target_dir | "{output_dir}/{directory}"
        target | "{target_dir}/{filename}"
        if :file_exists(source)
            if :file_exists(target) == false or refresh
                :create_dir!(target_dir)
                :copy_file!(source, target)
            xx
        else
            :say("GOBLIN-REPL: WARNING - asset missing: {source}")
        xx
    xx
xx

act init(pre_ctx)
    copy_assets(pre_ctx{"portal"}, true, pre_ctx{"output_dir"})
    :say("GOBLIN-REPL: Initialized")
    return pre_ctx
xx

act apply_tokens(ctx)
    body | ctx{"body"} ?? => return ctx
    token | "{{{GOBLIN_REPL::EMBED}}}"
    if :has(body, token) == false => return ctx

    /// Do not register HTML globally: an earlier module resolving tokens on the
    /// next page would inject it before Markdown and turn indentation into code.
    stash | []
    original, key | ""
    sweep body
        "<pre" ... "</pre>":
            original |= self
            key |= "@@GOBLIN_REPL_PROTECTED_{stash.len}@@"
            :put_last!(stash, {"key":key, "body":original})
            :update_where!(body, original, key)
    xx
    sweep body
        "<code" ... "</code>":
            original |= self
            key |= "@@GOBLIN_REPL_PROTECTED_{stash.len}@@"
            :put_last!(stash, {"key":key, "body":original})
            :update_where!(body, original, key)
    xx
    sweep body
        "<script" ... "</script>":
            original |= self
            key |= "@@GOBLIN_REPL_PROTECTED_{stash.len}@@"
            :put_last!(stash, {"key":key, "body":original})
            :update_where!(body, original, key)
    xx
    sweep body
        "<style" ... "</style>":
            original |= self
            key |= "@@GOBLIN_REPL_PROTECTED_{stash.len}@@"
            :put_last!(stash, {"key":key, "body":original})
            :update_where!(body, original, key)
    xx
    if :has(body, token)
        embed_html | "<div class=\"goblin-repl-placeholder\"></div>\n<script src=\"/public/js/goblin-repl.js?v=0.51.26\" defer></script>"
        :update_where!(body, "<p>{token}</p>", embed_html)
        :update_where!(body, token, embed_html)
        copy_assets(ctx{"portal"}, false, ctx{"output_dir"})
    xx
    for item in stash
        :update_where!(body, item{"key"}, item{"body"})
    xx
    :update!(ctx{"body"}, body)
    return ctx
xx
