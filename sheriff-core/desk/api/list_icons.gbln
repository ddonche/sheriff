/// /api/list_icons?{portal}: Core icons plus portal-local overrides. Read-only.
root | :trim(:env("SHERIFF_ROOT"))
if root == "" => root |= ".."
portal | :trim(:url_decode(:env("GOBLIN_QUERY_STRING")))
known | :list_dirs("{root}/site/portals")
valid_portal | false
for name in known
    if name == portal => valid_portal |= true
xx
if !portal.nix? and valid_portal == false
    :say(:json_stringify({"ok": false, "stderr": "Unknown portal", "icons": []}))
else
    by_name | {}
    names | []
    folders | [{"path": "{root}/sheriff-core/assets/icons", "source": "Core"}]
    if valid_portal
        :put_last!(folders, {"path": "{root}/site/portals/{portal}/public/icons", "source": "Portal"})
    xx
    for folder in folders
        dir | folder{"path"}
        if :file_exists(dir) == false => skip
        has_png | false
        for file in :walk(dir, "**/*")
            if :ends_with(file, ".png") => has_png |= true
        xx
        if folder{"source"} == "Portal" and has_png
            command | "python3 sheriff-core/desk/api/icon-support/png-icons.py"
            if :env("OS") == "Windows_NT"
                command |= "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File sheriff-core/desk/api/icon-support/png-icons.ps1"
            xx
            result | :json_parse(:run_cmd(command, root, {"SHERIFF_ICON_DIRECTORY": "site/portals/{portal}/public/icons"}))
            if result{"ok"} == false
                :say(:json_stringify({"ok": false, "stderr": "Could not load PNG icons. Windows uses PowerShell; macOS/Linux require Python 3.", "icons": []}))
                return nil
            xx
            for icon in :json_parse(result{"stdout"})
                name | icon{"name"}
                if :has(by_name, name) == false => :put_last!(names, name)
                :update!(by_name{name}, icon)
            xx
        xx
        for file in :walk(dir, "**/*")
            if :ends_with(file, ".svg") == false => skip
            name | :stem(file)
            if :slug(name) != name => skip
            if :has(by_name, name) == false => :put_last!(names, name)
            :update!(by_name{name}, {"name": name, "source": folder{"source"}, "svg": :read_text(file)})
        xx
    xx
    icons | []
    for name in :sort(names)
        :put_last!(icons, by_name{name})
    xx
    :say(:json_stringify({"ok": true, "icons": icons}))
xx
