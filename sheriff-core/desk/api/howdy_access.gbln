/// Local CGI runs from dist; invoke the shared module from sheriff-core.
/// Cloud uses this same endpoint and carries its authenticated portal scope.
act handle()
    if :env("SHERIFF_RUNTIME_MODE") == "cloud" => return {"ok":false,"stderr":"Use the authenticated Cloud gateway."}
    if :env("GOBLIN_METHOD") != "POST" => return {"ok":false,"stderr":"Use POST for Howdy access."}
    headers | :json_parse(:env("GOBLIN_HEADERS_JSON") ?? "{}")
    origin | headers{"origin"} ?? ""
    host | headers{"host"} ?? ""
    loopback | host == "" or host == "localhost" or host == "127.0.0.1" or host == "[::1]" or :starts_with(host,"localhost:") or :starts_with(host,"127.0.0.1:") or :starts_with(host,"[::1]:")
    if !loopback => return {"ok":false,"stderr":"Howdy access requires local Desk on a loopback address."}
    if origin != "" and origin != "http://{host}" => return {"ok":false,"stderr":"Open Howdy access from local Desk."}
    root | :trim(:env("SHERIFF_ROOT"))
    if root.nix? => root |= ".."
    body | :env("GOBLIN_BODY")
    incoming | :env("GOBLIN_REQUEST_FILE")
    if !incoming.nix? => body |= :read_text(incoming)
    if body.len > 4194304 => return {"ok":false,"stderr":"Howdy access files must be at most 4 MB."}
    request_dir | "{root}/data/desk-howdy-access-requests"
    :create_dir!(request_dir)
    id | :uuid_v4()
    request_file | "{request_dir}/{id}.txt"
    :write_text!(request_file, body)
    result | ..
    attempt
        env | {"SHERIFF_ROOT":root, "GOBLIN_METHOD":"POST", "GOBLIN_QUERY_STRING": :env("GOBLIN_QUERY_STRING"), "GOBLIN_BODY":"", "SHERIFF_ACCESS_BEARER":headers{"authorization"} ?? "", "GOBLIN_REQUEST_FILE":"../data/desk-howdy-access-requests/{id}.txt"}
        result |= :json_parse(:run_cmd("goblin run desk/admin/requests/howdy_access_request.gbln", "{root}/sheriff-core", env))
    rescue err
        :delete_path!(request_file)
        return {"ok":false,"stderr": :str(err)}
    xx
    :delete_path!(request_file)
    if result{"ok"} == false => return {"ok":false,"stderr":result{"stderr"} ?? "Howdy access runtime failed."}
    data | :json_parse(result{"stdout"})
    while :valtype(data) == "map" and :has(data, "body") and :has(data, "status")
        if :valtype(data{"body"}) == "str"
            data |= :json_parse(data{"body"})
        else
            data |= data{"body"}
        xx
    xx
    return data
xx
attempt
    :say(:json_stringify(handle()))
rescue err
    :say(:json_stringify({"ok":false,"stderr": :str(err)}))
xx
